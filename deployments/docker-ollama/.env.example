# Copy to .env in this directory. All values are optional.

# Ollama on the host (default). With compose.ollama.yaml this is overridden.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Default model, and optionally every model the agent may select
# (comma-separated). Each must be pulled into Ollama.
OLLAMA_MODEL=qwen3-coder:30b
# OLLAMA_MODELS=qwen3-coder:30b,gpt-oss:20b

# Host folder whose Git repositories the worker may use. Windows example:
# WORKSPACE_DIR=C:/Users/you/code
WORKSPACE_DIR=./workspace

# Web UI on http://localhost:${MACHINIST_PORT}
MACHINIST_PORT=7331

# Author for the agent's commits.
GIT_USER_NAME=Machinist Agent
GIT_USER_EMAIL=machinist@localhost

# compose.ollama.yaml only.
# OLLAMA_IMAGE_TAG=latest
# OLLAMA_CONTEXT_LENGTH=32768
# OLLAMA_HOST_PORT=11435
